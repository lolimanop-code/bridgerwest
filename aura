local function UpdatePlayerList()
    for _, child in ipairs(PlayerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local players = Players:GetPlayers()
    local count = 0
    
    for _, player in ipairs(players) do
        if player == LocalPlayer then continue end
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btn.BorderSizePixel = 0
        btn.Text = ""
        btn.ZIndex = 11
        btn.Parent = PlayerScroll
        
        local btnName = Instance.new("TextLabel")
        btnName.Size = UDim2.new(1, -50, 1, 0)
        btnName.Position = UDim2.new(0, 12, 0, 0)
        btnName.BackgroundTransparency = 1
        btnName.Text = player.Name
        btnName.TextColor3 = Color3.fromRGB(255, 255, 255)
        btnName.Font = Enum.Font.GothamBold
        btnName.TextSize = 13
        btnName.TextXAlignment = Enum.TextXAlignment.Left
        btnName.ZIndex = 11
        btnName.Parent = btn
        
        local char = player.Character
        local hp = char and char:FindFirstChild("Humanoid") and char.Humanoid.Health or 0
        local hpDot = Instance.new("Frame")
        hpDot.Size = UDim2.new(0, 12, 0, 12)
        hpDot.Position = UDim2.new(1, -30, 0.5, -6)
        hpDot.BackgroundColor3 = hp > 0 and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        hpDot.BorderSizePixel = 0
        hpDot.ZIndex = 11
        Instance.new("UICorner", hpDot).CornerRadius = UDim.new(1, 0)
        hpDot.Parent = btn
        
        btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70) end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50) end)
        
        btn.MouseButton1Click:Connect(function()
            getgenv().Aura.Target = player.Name
            getgenv().Aura.TargetPlayer = player
            DropdownText.Text = player.Name
            DropdownText.TextColor3 = Color3.fromRGB(0, 255, 200)
            TargetStatus.Text = "Target: " .. player.Name
            TargetStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
            PlayerList.Visible = false
            getgenv().Aura.DropdownOpen = false
            DropdownArrow.Text = "▼"
        end)
        
        count = count + 1
    end
    
    if count == 0 then
        local noPlayers = Instance.new("TextLabel")
        noPlayers.Size = UDim2.new(1, 0, 0, 30)
        noPlayers.BackgroundTransparency = 1
        noPlayers.Text = "No players on server"
        noPlayers.TextColor3 = Color3.fromRGB(200, 200, 200)
        noPlayers.Font = Enum.Font.Gotham
        noPlayers.TextSize = 12
        noPlayers.Parent = PlayerScroll
    end
    
    PlayerList.Size = UDim2.new(1, 0, 0, math.min(count, 6) * 30 + 6)
end

DropdownButton.MouseButton1Click:Connect(function()
    getgenv().Aura.DropdownOpen = not getgenv().Aura.DropdownOpen
