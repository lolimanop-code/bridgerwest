local Workspace = game:GetService("Workspace")
local auraConnection = nil
local spamActive = false
local auraAngle = 0
local lastPosChange = 0

local function IsMouseOverGUI()
    if not MainFrame or not MainFrame.Visible then return false end
    local mousePos = UserInputService:GetMouseLocation()
    local framePos = MainFrame.AbsolutePosition
    local frameSize = MainFrame.AbsoluteSize
    return mousePos.X >= framePos.X and mousePos.X <= framePos.X + frameSize.X
       and mousePos.Y >= framePos.Y and mousePos.Y <= framePos.Y + frameSize.Y
end

local function ClickLMB()
    if IsMouseOverGUI() then return end
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function PressKey(key)
    if IsMouseOverGUI() then return end
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function StopAura()
    if auraConnection then auraConnection:Disconnect(); auraConnection = nil end
    spamActive = false
end

local function SpamLoop()
    -- Цикл 1: Спам ЛКМ каждые 0.1 сек
    task.spawn(function()
        while spamActive do
            if not spamActive then break end
            ClickLMB()
            task.wait(0.1)
        end
    end)
    
    -- Цикл 2: Спам клавиш с задержкой 0.15 сек между ними
    task.spawn(function()
        while spamActive do
            local cfg = getgenv().Aura
            
            if not spamActive then break end
            if cfg.Key1 then PressKey(Enum.KeyCode.One); task.wait(0.1) end
            
            if not spamActive then break end
            if cfg.Key2 then PressKey(Enum.KeyCode.Two); task.wait(0.1) end
            
            if not spamActive then break end
            if cfg.Key3 then PressKey(Enum.KeyCode.Three); task.wait(0.1) end
            
            if not spamActive then break end
            if cfg.Key4 then PressKey(Enum.KeyCode.Four); task.wait(0.1) end
            
            if not spamActive then break end
            if cfg.KeyG then PressKey(Enum.KeyCode.G); task.wait(0.1) end
            
            if not spamActive then break end
        end
    end)
end

local function StartAura(target, distance)
    StopAura()
    
    auraConnection = RunService.Heartbeat:Connect(function()
        if not target then StopAura() return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        local targetPos = Vector3.zero
        if target.Character then
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                targetPos = targetRoot.Position
            elseif target.Character:FindFirstChild("Head") then
                targetPos = target.Character.Head.Position
            end
        else
            return
        end
        
        if tick() - lastPosChange > 3 then
            lastPosChange = tick()
            auraAngle = math.random(0, 360)
        end
        
        auraAngle = auraAngle + 1.5
        local rad = math.rad(auraAngle)
        local yOffset = math.sin(tick() * 1.5) * 1.5
        local offset = Vector3.new(math.cos(rad) * distance, yOffset, math.sin(rad) * distance)
        myRoot.CFrame = CFrame.new(targetPos + offset, targetPos)
    end)
    
    spamActive = true
    task.spawn(SpamLoop)
end

task.spawn(function()
    while true do
        local cfg = getgenv().Aura
        if not cfg.Enabled then StopAura(); repeat task.wait(0.3) until getgenv().Aura.Enabled end
        local target = cfg.TargetPlayer
        if not target then StopAura(); task.wait(1); continue end
        if not auraConnection then StartAura(target, cfg.Distance) end
        task.wait(0.2)
    end
end)

